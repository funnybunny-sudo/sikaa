# ─────────────────────────────────────────
# sika-backend — Environment Variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────

# Anthropic Claude API key (keep this server-side ONLY)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase service role key (server-side only — has admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server config
PORT=3000
NODE_ENV=development

# Allowed origins for CORS (comma-separated)
# In production, set this to your actual app domain / Expo bundle ID
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
